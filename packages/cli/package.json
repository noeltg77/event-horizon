{
  "name": "localmax",
  "version": "0.1.0",
  "description": "Run open LLMs locally, tuned to your exact hardware for the most tokens per second without losing quality.",
  "type": "module",
  "bin": {
    "localmax": "dist/index.js"
  },
  "files": [
    "dist"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "tsup && node scripts/copy-ui.mjs",
    "dev": "tsx watch src/index.ts --no-open --port 4747"
  },
  "keywords": [
    "llm",
    "llama.cpp",
    "local",
    "gguf",
    "inference",
    "openai-compatible"
  ],
  "dependencies": {
    "@hono/node-server": "2.1.5",
    "commander": "14.0.3",
    "hono": "4.13.14",
    "picocolors": "1.1.1",
    "systeminformation": "5.33.16"
  },
  "devDependencies": {
    "@localmax/core": "0.1.0",
    "tsup": "9.0.0",
    "tsx": "4.23.15"
  }
}
